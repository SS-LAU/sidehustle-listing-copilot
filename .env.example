# Copy to .env and fill in. Everything is optional — the app runs fully without any of them.

# Ollama (local, on-device AI). Defaults are fine for local dev.
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120

# Optional: SerpApi competitor pricing. Leave empty to auto-hide the pricing section.
SERPAPI_KEY=

# Optional: MongoDB Atlas connection. Leave empty to fall back to local demo/listings.json.
MONGODB_URI=
MONGODB_DB=sidehustle
